			<version>${axon.version}</version>
		</dependency>

		<!-- AxoniqFramework distributed tracing (feature 3594).
		     - axoniq-tracing-opentelemetry: OpenTelemetrySpanFactory + opentelemetry-api binding.
		     - axoniq-tracing-{messaging,modelling,eventsourcing,distributed}: per-concern decorators,
		       each ServiceLoader-discovered, that wrap the command/event/query buses, repositories,
		       snapshot store, and the Axon Server connector legs. All tracing concern modules are
		       pulled in so the full span set is available regardless of runtime configuration. The
		       Spring Boot autoconfig that wires these lives in axoniq-spring-boot-autoconfigure,
		       already on the classpath via the starter above. -->
		<dependency>
			<groupId>io.axoniq.framework</groupId>
			<artifactId>axoniq-tracing-opentelemetry</artifactId>
			<version>${axon.version}</version>
		</dependency>
		<dependency>
			<groupId>io.axoniq.framework</groupId>
			<artifactId>axoniq-tracing-messaging</artifactId>
			<version>${axon.version}</version>
		</dependency>
