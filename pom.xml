					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-compiler-plugin</artifactId>
						<configuration>
							<includes>
								<include>com/dddheroes/heroesofddd/resourcespool/write/ResourcesPool.java</include>
								<include>com/dddheroes/heroesofddd/resourcespool/write/ResourcesPoolId.java</include>
