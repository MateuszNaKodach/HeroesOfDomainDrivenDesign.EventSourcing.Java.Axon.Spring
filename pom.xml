	<artifactId>heroesofddd</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>heroesofddd</name>
	<description>heroesofddd</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<assertj.version>3.27.3</assertj.version>
		<axon.version>5.1.1-SNAPSHOT</axon.version>
		<axon5.version>5.1.1-SNAPSHOT</axon5.version>
