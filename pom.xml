			<artifactId>axoniq-tracing-modelling</artifactId>
			<version>${axon.version}</version>
		</dependency>
		<dependency>
			<groupId>io.axoniq.framework</groupId>
			<artifactId>axoniq-tracing-eventsourcing</artifactId>
			<version>${axon.version}</version>
		</dependency>
		<dependency>
			<groupId>io.axoniq.framework</groupId>
			<artifactId>axoniq-tracing-distributed</artifactId>
			<version>${axon.version}</version>
		</dependency>

		<!-- OpenTelemetry export pipeline. Spring Boot's actuator tracing autoconfiguration creates the
		     io.opentelemetry.api.OpenTelemetry SDK bean (configured by the management.tracing.* /
		     management.otlp.tracing.* properties in the 'observability' profiles) and exports spans over
		     OTLP. AxoniqFramework's OpenTelemetryTracingAutoConfiguration consumes that same OpenTelemetry
		     bean, so framework spans and HTTP server spans share one tracer/exporter. Versions are managed
		     by the Spring Boot parent BOM, keeping opentelemetry-api/-sdk aligned across both stacks.
		     Without the 'observability' profile, management.tracing.enabled=false → no OpenTelemetry bean →
		     the factory falls back to a no-op GlobalOpenTelemetry and nothing is exported. -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-tracing-bridge-otel</artifactId>
		</dependency>
		<dependency>
			<groupId>io.opentelemetry</groupId>
			<artifactId>opentelemetry-exporter-otlp</artifactId>
		</dependency>

