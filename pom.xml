								<include>com/dddheroes/heroesofddd/creaturerecruitment/read/getalldwellings/GetAllDwellings.java</include>
								<include>com/dddheroes/heroesofddd/creaturerecruitment/read/DwellingReadModel.java</include>
								<include>com/dddheroes/heroesofddd/creaturerecruitment/read/DwellingReadModelRepository.java</include>
								<include>com/dddheroes/heroesofddd/creaturerecruitment/events/DwellingEvent.java</include>
								<include>com/dddheroes/heroesofddd/creaturerecruitment/events/DwellingBuilt.java</include>
								<include>com/dddheroes/heroesofddd/shared/application/GameMetaData.java</include>
							</includes>
							<!-- Dual-natured class — only the @EventHandler shape is migrated by the event-processor recipe.
							     @QueryHandler shape is surfaced for query-handler recipe (Phase 6).
							     Functional verification (E2E `GetAllDwellingsTest`) deferred to stabilization. -->
							<testIncludes>
								<testInclude>__no_scoped_test__/None.java</testInclude>
							</testIncludes>
						</configuration>
					</plugin>
				</plugins>
			</build>
